# ============================================================================
# RUST WIPE MANAGER - CONFIGURATION
# Copy this file to config.env and adjust it. Every setting is explained above
# its line. Secrets (Telegram token, chat id, RCON password) go to .secrets.env.
#
# How it runs: cron needs only two lines, everything else is decided here.
#   * * * * * /home/YOUR_USERNAME/rust_server/manager.sh tick >> /home/YOUR_USERNAME/rust_server/logs/cron.log 2>&1
#   @reboot   /home/YOUR_USERNAME/rust_server/manager.sh post-boot >> /home/YOUR_USERNAME/rust_server/logs/cron.log 2>&1
# "tick" runs every minute: if a restart or a wipe is due now it runs it,
# otherwise it runs the watchdog.
#
# All times are the VM's local time (see `timedatectl`). An event fires once a
# day inside a window after its time (1 h for the restart and the map wipe,
# 3 h for the full wipe); a VM that was off then skips it rather than running
# it hours late.
# Booleans are "true" / "false". Durations are in seconds unless the name says otherwise.
# ============================================================================


# ----------------------------------------------------------------------------
# Paths
# ----------------------------------------------------------------------------

# The LinuxGSM script of the server (created by `./linuxgsm.sh rustserver`).
LGSM_SCRIPT="/home/YOUR_USERNAME/rustserver"

# Where RCON listens. The script talks to the server from the same machine,
# so this is almost always 127.0.0.1.
RCON_HOST="127.0.0.1"

# RCON port: rconport in lgsm/config-lgsm/rustserver/rustserver.cfg
# (by default the game port + 1, e.g. 28016).
RCON_PORT="28016"

# Path to the rcon-cli binary (https://github.com/gorcon/rcon-cli).
RCON_CLI="/home/YOUR_USERNAME/rcon-0.10.3-amd64_linux/rcon"

# LinuxGSM's serverfiles directory (holds RustDedicated and RustDedicated_Data/).
SERVERFILES_DIR="/home/YOUR_USERNAME/serverfiles"


# ----------------------------------------------------------------------------
# Names used in Telegram messages
# ----------------------------------------------------------------------------

# Full server name: used in the big messages (restart started, new wipe is live).
SERVER_NAME="My Rust Server"

# Short tag: prefixes every other message, handy with several servers in one chat.
SERVER_TAG="MYSERVER"


# ----------------------------------------------------------------------------
# Telegram
# ----------------------------------------------------------------------------

# Send messages to Telegram at all. "false" = only the local log.
ENABLE_TELEGRAM="true"

# Which messages to send:
#   full          - every step (restart started, RCON sent, stopped, updated, ...)
#   success_error - only the final result of each run and errors
#   error_only    - only errors (quiet chat, still wakes you when something breaks)
TELEGRAM_LOG_LEVEL="full"

# Language of the Telegram messages: en | ru. The log file is always English.
MESSAGES_LANG="en"


# ----------------------------------------------------------------------------
# Daily restart
# ----------------------------------------------------------------------------

# Restart the server once a day (updates Rust/Oxide/OS while it is down).
DAILY_RESTART_ENABLED="true"

# When the restart starts, HH:MM. The countdown begins at this time, so the
# server actually goes down DAILY_RESTART_COUNTDOWN later.
DAILY_RESTART_TIME="04:30"

# Countdown shown to players before the restart, in seconds (1800 = 30 min).
DAILY_RESTART_COUNTDOWN=1800

# Update the Rust server (SteamCMD) during the daily restart.
DAILY_RESTART_UPDATE_RUST="true"

# Update Oxide/uMod during the daily restart.
DAILY_RESTART_UPDATE_OXIDE="true"

# Skip the daily restart on the Full Wipe day (the wipe in the evening
# restarts and updates the server anyway).
SKIP_DAILY_RESTART_ON_FULLWIPE_DAY="true"


# ----------------------------------------------------------------------------
# Full Wipe (map + blueprints) - first Thursday of the month
# Facepunch releases the forced update that day, so the day is not configurable.
# ----------------------------------------------------------------------------

# Do the monthly Full Wipe automatically.
FULLWIPE_ENABLED="true"

# Countdown shown to players before the server stops for any wipe (Full or Map),
# in seconds (600 = 10 min).
FULLWIPE_COUNTDOWN=600

# Hour (London time) at which Facepunch releases the monthly update. 19 is
# their usual time; the script converts it to the VM's time by itself.
FULLWIPE_LONDON_HOUR=19

# Start the countdown this many minutes before that hour, so the server is
# already down when the update appears.
FULLWIPE_PRE_WAIT_MINUTES=30

# How long to wait for the update to show up in Steam, in seconds (7200 = 2 h).
# If it does not come, the wipe is cancelled and you get an alert.
FULLWIPE_UPDATE_WAIT_MAX=7200

# How often to ask Steam whether the update is out, in seconds.
FULLWIPE_UPDATE_CHECK_INTERVAL=120


# ----------------------------------------------------------------------------
# Map Wipe (map only, blueprints kept) - your own schedule
# ----------------------------------------------------------------------------

# Do map wipes between the monthly Full Wipes.
MAPWIPE_ENABLED="false"

# Day of the week: 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat 7=Sun.
# Never runs on the Full Wipe day.
MAPWIPE_DAY=5

# When the map wipe starts, HH:MM. The countdown (FULLWIPE_COUNTDOWN) begins
# at this time, the wipe itself happens after it.
MAPWIPE_TIME="19:00"

# How often: 1 = every week, 2 = every two weeks, and so on. Counted from the
# last wipe of any kind (the age of the current map), so after the forced
# Thursday wipe the next day is skipped and the count starts over.
MAPWIPE_INTERVAL_WEEKS=1

# Only on these days of the month, "FROM-TO"; empty = any day. "16-22" with
# MAPWIPE_DAY=5 gives exactly one map wipe a month, on the Friday two weeks after
# the forced first-Thursday wipe (the first Thursday is always the 1st-7th), so the
# server wipes exactly twice a month. A plain two-week interval would add a third
# wipe in five-week months, a week before the forced one.
MAPWIPE_MONTH_DAYS=""

# Opening time after a wipe, HH:MM; empty = open as soon as the server is up.
# The server comes up with maxplayers 0: everyone who connects waits in Rust's own
# queue ("position N"), and at this time maxplayers goes back to the LGSM value and
# the queue joins. Start the wipe early enough for the map to generate (~12 min for
# 3500), e.g. MAPWIPE_TIME="19:15" + 30-min countdown + generation -> open "20:00".
MAPWIPE_OPEN_TIME=""
# Either value may also be "+N": open at the next N-minute mark after the server is
# up (e.g. "+5": up at 22:13 -> opens 22:15), so nobody waits in the queue longer
# than N minutes. Handy for the Full Wipe, whose start depends on Facepunch's update.
FULLWIPE_OPEN_TIME=""

# Show the real next wipe from this schedule in the server browser ("wipe in ...")
# through wipetimer.wipeunixtimestampoverride. Re-applied after every server start.
WIPETIMER_ENABLED="false"

# Examples:
#   every Friday at 19:00            MAPWIPE_DAY=5  MAPWIPE_TIME="19:00"  MAPWIPE_INTERVAL_WEEKS=1
#   every two weeks, Monday 18:00    MAPWIPE_DAY=1  MAPWIPE_TIME="18:00"  MAPWIPE_INTERVAL_WEEKS=2
#   twice a month (forced + mid-month Friday)  MAPWIPE_DAY=5  MAPWIPE_MONTH_DAYS="16-22"
# The map seed changes on every wipe by itself if seed="" in rustserver.cfg.


# ----------------------------------------------------------------------------
# Oxide / uMod
# ----------------------------------------------------------------------------

# Copy RustDedicated_Data/Managed to Managed.backup-<date> before updating
# Oxide (copies older than 30 days are deleted). Needed for the rollback below.
OXIDE_BACKUP_BEFORE_UPDATE="true"

# After every start: wait until RCON answers, then check that Oxide is loaded
# (oxide.version). If it is not, restore the Managed/ copy and start again.
OXIDE_CHECK_ENABLED="true"

# How long to wait for RCON after a start, in seconds. Must cover map
# generation after a wipe, which takes 10+ minutes on slow hardware.
OXIDE_LOAD_TIMEOUT=900


# ----------------------------------------------------------------------------
# OS maintenance - runs in the daily restart window, while the server is down
# ----------------------------------------------------------------------------

# Install OS updates with unattended-upgrade (after apt-get update), while the
# server is down. WHAT gets installed is Ubuntu's own setting, not this file:
# Unattended-Upgrade::Allowed-Origins in /etc/apt/apt.conf.d/50unattended-upgrades
# (Ubuntu default: security updates, plus ESM if enabled). WHEN is this window.
# Ubuntu also runs unattended-upgrade by itself at a random time of day; turn
# that off so updates land only here: in /etc/apt/apt.conf.d/20auto-upgrades set
#   APT::Periodic::Update-Package-Lists "1";
#   APT::Periodic::Unattended-Upgrade "0";
# Log of what was installed: /var/log/unattended-upgrades/unattended-upgrades.log
SYSTEM_UPDATE_ENABLED="true"

# If the OS needs a reboot (new kernel etc.), reboot the VM instead of
# starting the server; the systemd unit starts Rust on boot.
# One-time power-off for host maintenance: `touch .poweroff-once` next to
# manager.sh - at the next daily restart the VM powers off instead (the host
# has to start it again).
REBOOT_IF_REQUIRED="true"


# ----------------------------------------------------------------------------
# Server start
# ----------------------------------------------------------------------------

# How long to wait for the RustDedicated process to appear after a start,
# in seconds. Only the process: full loading is OXIDE_LOAD_TIMEOUT.
SERVER_START_TIMEOUT=600


# ----------------------------------------------------------------------------
# Watchdog - runs every minute inside "tick"
# ----------------------------------------------------------------------------

# Restart the server if it crashed or hung. A server stopped on purpose
# (./rustserver stop or systemctl stop rustserver) is never restarted.
# Stopping it with a console/RCON "quit" counts as a crash.
WATCHDOG_ENABLED="true"

# Do not check a server for hanging until its process is this old, in seconds
# (1800 = 30 min), so a long map generation is not taken for a hang.
WATCHDOG_GRACE=1800

# Treat the server as hung when RCON does not answer this many minutes in a row.
WATCHDOG_HANG_CHECKS=5

# At most this many watchdog restarts within an hour. Beyond that it stops
# trying and sends one alert: something is broken that a restart won't fix.
WATCHDOG_MAX_RESTARTS=3


# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------

# Where manager-YYYYMMDD.log and cron.log go.
LOG_DIR="/home/YOUR_USERNAME/rust_server/logs"

# Delete manager-*.log files older than this many days. cron.log is rotated
# to cron.log.1 when it grows past 10 MB.
LOG_KEEP_DAYS=30
