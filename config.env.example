# ============================================================================
# RUST WIPE MANAGER - CONFIGURATION
# Copy this file to config.env and adjust to your needs
# ============================================================================

# Schedule: one cron line runs everything below at the right time:
#   * * * * * /home/YOUR_USERNAME/rust_server/manager.sh tick >> /home/YOUR_USERNAME/rust_server/logs/cron.log 2>&1
#   @reboot   /home/YOUR_USERNAME/rust_server/manager.sh post-boot >> /home/YOUR_USERNAME/rust_server/logs/cron.log 2>&1
# Times are the VM's local time. A VM that was off at the scheduled time skips it (1 h window).

# --- General paths ---
LGSM_SCRIPT="/home/YOUR_USERNAME/rustserver"
RCON_HOST="127.0.0.1"
RCON_PORT="28016"
RCON_CLI="/home/YOUR_USERNAME/rcon-0.10.3-amd64_linux/rcon"
SERVERFILES_DIR="/home/YOUR_USERNAME/serverfiles"

# --- Server name for messages ---
SERVER_NAME="My Rust Server"
SERVER_TAG="MYSERVER"

# --- Telegram ---
ENABLE_TELEGRAM="true"
TELEGRAM_LOG_LEVEL="full"  # full | success_error | error_only
MESSAGES_LANG="en"         # en | ru

# --- Daily restart ---
DAILY_RESTART_ENABLED="true"
DAILY_RESTART_TIME="04:30"          # VM local time
DAILY_RESTART_COUNTDOWN=1800        # countdown in seconds (30 minutes)
DAILY_RESTART_UPDATE_RUST="true"    # update Rust on daily restart
DAILY_RESTART_UPDATE_OXIDE="true"   # update Oxide on daily restart

# --- Full Wipe ---
FULLWIPE_ENABLED="true"
FULLWIPE_COUNTDOWN=600              # countdown before stop (10 minutes)
FULLWIPE_LONDON_HOUR=19             # hour in London time when Facepunch releases updates
FULLWIPE_PRE_WAIT_MINUTES=30        # how many minutes before update to start preparing
FULLWIPE_UPDATE_WAIT_MAX=7200       # max wait for update (2 hours)
FULLWIPE_UPDATE_CHECK_INTERVAL=120  # check update every 2 minutes

# --- Map Wipe schedule (map only, blueprints kept) ---
# The Full Wipe stays on the first Thursday: Facepunch's forced update sets that day.
MAPWIPE_ENABLED="false"
MAPWIPE_DAY=5                       # 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat 7=Sun
MAPWIPE_TIME="19:00"                # VM local time; the countdown (FULLWIPE_COUNTDOWN) starts then
MAPWIPE_INTERVAL_WEEKS=1            # 1 = every week, 2 = every two weeks, ...; counted from the
                                    # last wipe of any kind, so it lines up with the forced wipe

# --- Behavior on Full Wipe day ---
SKIP_DAILY_RESTART_ON_FULLWIPE_DAY="true"

# --- Oxide ---
OXIDE_BACKUP_BEFORE_UPDATE="true"   # backup Managed/ before update
OXIDE_CHECK_ENABLED="true"          # after a start: wait for RCON, check oxide.version, roll Managed/ back if Oxide is broken
OXIDE_LOAD_TIMEOUT=900              # max wait for RCON after a start (sec); map generation after a wipe is slow

# --- OS maintenance (runs in the daily restart window, while the server is down) ---
SYSTEM_UPDATE_ENABLED="true"        # apt-get update + unattended-upgrade; turn off the
                                    # APT::Periodic::Unattended-Upgrade timer so updates land only here
REBOOT_IF_REQUIRED="true"           # reboot the VM instead of starting the server when the OS asks
                                    # (touch .poweroff-once next to manager.sh for a one-time power-off)

# --- Server start ---
SERVER_START_TIMEOUT=600            # max wait for process to appear (sec)

# --- Watchdog (runs every minute inside "manager.sh tick") ---
WATCHDOG_ENABLED="true"             # restart a crashed or hung server; a clean stop (rustserver stop /
                                    # systemctl stop) is respected and never restarted
WATCHDOG_GRACE=1800                 # don't call a server hung until its process is this old (sec)
WATCHDOG_HANG_CHECKS=5              # RCON silent this many minutes in a row = hung
WATCHDOG_MAX_RESTARTS=3             # per hour; beyond that the watchdog gives up and alerts

# --- Logs ---
LOG_KEEP_DAYS=30                    # delete manager-*.log older than this
LOG_DIR="/home/YOUR_USERNAME/rust_server/logs"
